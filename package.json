{
  "name": "miniopenclaw",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "miniopenclaw": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "npm run build && node dist/gateway/index.js",
    "start:gateway": "npm run build && node dist/gateway/index.js",
    "start:agent": "npm run build && node dist/cli.js agent",
    "auth": "npm run build && node dist/cli.js auth",
    "onboard": "npm run build && node dist/cli.js onboard",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.74.0",
    "@opentui/core": "^0.2.15",
    "better-sqlite3": "^12.10.0",
    "bun": "^1.3.14",
    "chokidar": "^4.0.3",
    "fastify": "^5.8.5",
    "web-tree-sitter": "^0.25.10"
  }
}
